# =====================================================================
# BroFit environment variables template
# Copy to `.env.local` (development) or `.env.production` (production)
# Fill in real values. NEVER commit real secrets.
# =====================================================================

# --- Supabase (public, safe to expose to the browser) ---
# Dashboard: https://supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# --- Supabase (SERVER-ONLY — must NEVER be in the browser) ---
# The service-role key bypasses RLS. Used by admin routes, chat, and diet API.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Admin login ---
# HMAC secret for the stateless admin token. Use a long random string (base64, min 32 chars).
# ⚠️ Rotate this if it was ever committed or shared.
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=<generate-a-long-random-base64-string>

# --- Cron (monthly revenue report) ---
# Guard for /api/cron/monthly-revenue. The cron invokes it with
# `Authorization: Bearer $CRON_SECRET`. Keep it a long random string (hex, 32 bytes).
# Generate with: openssl rand -hex 32
CRON_SECRET=<generate-a-long-random-hex-string>

# --- AI providers (any one is enough; the fallback stack tries them in order) ---
# Priority: Groq → Mistral → OpenRouter → Cohere
# Get keys from: console.groq.com, console.mistral.ai, openrouter.ai, dashboard.cohere.com
# GROQ_API_KEY is first in the fallback stack - add it first for AI features to work
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# --- Public data proxies (rate-limited server-side) ---
# Get key from: api-ninjas.com
API_NINJAS_KEY=

# --- Notifications ---
# Used for admin backup + contact-form notifications (optional).
DISCORD_WEBHOOK_URL=

# --- Distributed rate limiting + admin-token revocation (RECOMMENDED for prod) ---
# When both are set, rate limits and revoked admin tokens are shared across
# serverless instances via Upstash Redis (see lib/rate-limit.ts, lib/auth.ts).
# Without them the app falls back to per-instance in-memory state.
# Get from: upstash.com → database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
# Canonical site URL for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Daily AI credit cap ---
# Maximum daily credits per user for AI features. Default: 5
# Must match app_settings.max_daily_credits in database (see migration 2026-08-02-configurable-credits.sql)
MAX_DAILY_CREDITS=5

# --- Client IP trust for rate limiting ---
# When running on Vercel this is implicit (the platform strips client-set
# x-forwarded-for / x-real-ip). Self-hosted behind nginx/Cloudflare/etc. must
# set this to "true" or clients can spoof an IP and bypass per-IP rate limits.
# When false, rate limiting falls back to a single 'unknown' bucket.
TRUST_PROXY_HEADERS=false